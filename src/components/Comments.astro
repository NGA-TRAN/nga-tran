---
import { giscus } from "../lib/site";

const configured =
  !giscus.repoId.startsWith("REPLACE_") && !giscus.categoryId.startsWith("REPLACE_");
---

<section class="comments">
  <h2>Comments</h2>
  {
    configured ? (
      <script
        src="https://giscus.app/client.js"
        data-repo={giscus.repo}
        data-repo-id={giscus.repoId}
        data-category={giscus.category}
        data-category-id={giscus.categoryId}
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="light"
        data-lang="en"
        crossorigin="anonymous"
        async
      />
    ) : (
      <p class="comments-note">
        Comments will appear here after giscus is configured in <code>src/lib/site.ts</code>.
      </p>
    )
  }
</section>
