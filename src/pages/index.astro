---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FeaturedPost from "../components/FeaturedPost.astro";
import PostCard from "../components/PostCard.astro";
import { site } from "../lib/site";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [latest, ...earlier] = posts;
---

<BaseLayout>
  <section class="intro">
    <p class="intro-role">{site.role}</p>
    <h1 class="intro-title">Real‑world engineering lessons from building distributed query systems.</h1>
  </section>
  {latest && <FeaturedPost post={latest} />}
  {
    earlier.length > 0 && (
      <section class="earlier-posts" aria-labelledby="earlier-heading">
        <h2 id="earlier-heading" class="section-title">Earlier posts</h2>
        <div class="post-list">
          {earlier.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
