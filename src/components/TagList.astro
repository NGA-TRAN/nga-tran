---
import { withBase } from "../lib/site";

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tag-list">
      {tags.map((tag) => (
        <li>
          <a class="tag" href={withBase(`tags/${encodeURIComponent(tag)}/`)}>
            {tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
