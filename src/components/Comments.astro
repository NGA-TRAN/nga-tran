---
import { comments } from "../lib/site";
---

<section class="comments">
  <h2>Comments</h2>
  <div class="comments-host" data-comments-host></div>
</section>

<script is:inline define:vars={{ repo: comments.repo, issueTerm: comments.issueTerm, label: comments.label }}>
  (function () {
    const host = document.querySelector("[data-comments-host]");
    if (!host) return;

    const theme = document.documentElement.dataset.theme === "dark" ? "github-dark" : "github-light";
    const script = document.createElement("script");
    script.src = "https://utteranc.es/client.js";
    script.async = true;
    script.crossOrigin = "anonymous";
    script.setAttribute("repo", repo);
    script.setAttribute("issue-term", issueTerm);
    script.setAttribute("label", label);
    script.setAttribute("theme", theme);
    host.appendChild(script);
  })();
</script>
